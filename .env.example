# 3C Mall local-development environment example
#
# Production uses same-origin Cloudflare Pages Functions for /api routes.
# Do not add server secrets, private beta codes, Supabase credentials, or
# legacy Render backend URLs to VITE_* variables. VITE_* values are bundled
# into client-side JavaScript and are public by design.

# Optional public research / feedback form links.
VITE_WAITLIST_FORM_URL=
VITE_BETA_FORM_URL=

# Waitlist reporting is enabled by default. Set to false only for isolated
# local UI work where API reporting must be disabled intentionally.
VITE_REPORT_WAITLIST=true

# Optional diagnostic chip for non-production testing.
VITE_ALPHA_CHIP=0
